# FlashGroup Production & Demo Configuration
# Required: Obtain from Supabase Project Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: MapTiler Vector / Satellite API Key (Defaults to open CARTO vector if empty)
VITE_MAP_API_KEY=

# Application Mode: 'demo' (enables demo reset & test shortcuts) or 'production'
VITE_APP_MODE=demo
